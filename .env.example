# One Telegram bot manages all four channels.
# Один Telegram-бот керує всіма чотирма каналами.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Your numeric Telegram ID from @userinfobot.
# Твій цифровий Telegram ID.
OWNER_ID=123456789

# Optional additional admins separated by commas.
# Додаткові адміністратори через кому.
ADMIN_IDS=

DEFAULT_CHANNEL_KEY=hot_puppy
AUTO_START=1
BOT_LANGUAGE=ua
TIMEZONE=Europe/Kyiv
SCHEDULER_POLL_SECONDS=20
NOTIFY_OWNER=1
