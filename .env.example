# One Telegram bot manages multiple independent channel profiles.
# Один Telegram-бот керує кількома незалежними профілями каналів.
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Your numeric Telegram ID from @userinfobot.
# Твій цифровий Telegram ID.
OWNER_ID=PASTE_OWNER_ID_HERE

# Optional additional admins separated by commas.
# Додаткові адміністратори через кому.
ADMIN_IDS=

AUTO_START=1
BOT_LANGUAGE=ua
TIMEZONE=Europe/Kyiv
SCHEDULER_POLL_SECONDS=20
NOTIFY_OWNER=1

# Telegram Stars bot rental for non-owner admins.
# Оренда бота через Telegram Stars для адмінів, які не є owner.
BOT_RENTAL_STARS=100
BOT_RENTAL_DAYS=30

RENTAL_BASIC_STARS=100
RENTAL_BASIC_CHANNELS=1
RENTAL_PRO_STARS=250
RENTAL_PRO_CHANNELS=5
RENTAL_VIP_STARS=500
RENTAL_VIP_CHANNELS=20

RENTAL_REMINDERS_ENABLED=1
BACKUP_ENABLED=1
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14
